        'light-tertiary': '#7F562A',
        'light-on-tertiary': '#FFFFFF',
        'light-tertiary-container': '#FFDCBE',
        'light-on-tertiary-container': '#492901',
        'light-error': '#BA1A1A',
        'light-on-error': '#FFFFFF',
        'light-error-container': '#FFDAD6',
        'light-on-error-container': '#93000A',
        'light-background': '#F9F9FA',
        'light-on-background': '#191C1D',
        'light-surface': '#F9F9FA',
        'light-surface-dim': '#D9DADB',
        'light-surface-bright': '#FFFFFF',
        'light-surface-container-lowest': '#FFFFFF',
        'light-surface-container-low': '#F3F4F5',
        'light-surface-container': '#EDEEEF',
        'light-surface-container-high': '#E7E8E9',
        'light-surface-container-highest': '#E1E2E4',
        'light-on-surface': '#191C1D',
        'light-surface-variant': '#DCE4E7',
        'light-on-surface-variant': '#40484B',
        'light-outline': '#70787C',
        'light-outline-variant': '#C0C8CB',
        'light-inverse-surface': '#2E3132',
        'light-inverse-on-surface': '#F0F1F2',
        'light-inverse-primary': '#9ACEE1',
        'light-shadow': '#000000',
        'light-scrim': '#000000',
        'dark-primary': '#9ACEE1',
        'dark-on-primary': '#003542',
        'dark-primary-container': '#0F4C5C',
        'dark-on-primary-container': '#E0F4FD',
        'dark-secondary': '#B6CAD2',
        'dark-on-secondary': '#21333A',
        'dark-secondary-container': '#394C53',
        'dark-on-secondary-container': '#D2E6EE',
        'dark-tertiary': '#F3BC87',
        'dark-on-tertiary': '#492901',
        'dark-tertiary-container': '#623D13',
        'dark-on-tertiary-container': '#FFDCBE',
        'dark-error': '#FFB4AB',
        'dark-on-error': '#690005',
        'dark-error-container': '#93000A',
        'dark-on-error-container': '#FFDAD6',
        'dark-background': '#111415',
        'dark-on-background': '#E1E2E4',
        'dark-surface': '#111415',
        'dark-surface-dim': '#111415',
        'dark-surface-bright': '#37393B',
        'dark-surface-container-lowest': '#0C0F10',
        'dark-surface-container-low': '#191C1D',
        'dark-surface-container': '#1D2021',
        'dark-surface-container-high': '#282A2B',
        'dark-surface-container-highest': '#333536',
        'dark-on-surface': '#E1E2E4',
        'dark-surface-variant': '#40484B',
        'dark-on-surface-variant': '#C0C8CB',
        'dark-outline': '#8A9295',
        'dark-outline-variant': '#40484B',
        'dark-inverse-surface': '#E1E2E4',
        'dark-inverse-on-surface': '#2E3132',
        'dark-inverse-primary': '#306576',
        'dark-shadow': '#000000',
        'dark-scrim': '#000000',
      },
      borderRadius: {
        'sm': '4px',
        'DEFAULT': '8px',
        'md': '8px',
        'lg': '12px',
        'xl': '16px',
        'full': '9999px',
      },
      spacing: {
        'gutter-xs': '4px',
        'gutter-sm': '8px',
        'gutter-md': '16px',
        'gutter-lg': '24px',
        'gutter-xl': '32px',
        'section': '40px',
        'page-margin': '32px',
      },
      fontFamily: {
        'display': ['"Red Hat Display"', 'sans-serif'],
        'headline': ['"Red Hat Display"', 'sans-serif'],
        'title': ['"Instrument Sans"', 'sans-serif'],
        'body': ['"Instrument Sans"', 'sans-serif'],
        'label': ['"Instrument Sans"', 'sans-serif'],
        'mono': ['"Red Hat Mono"', 'monospace'],
      },
      fontSize: {
        'display-lg': ['36px', { lineHeight: '44px', letterSpacing: '-0.5px', fontWeight: '700' }],
        'display-lg-mobile': ['28px', { lineHeight: '34px', letterSpacing: '-0.25px', fontWeight: '700' }],
        'headline-lg': ['28px', { lineHeight: '34px', letterSpacing: '-0.25px', fontWeight: '700' }],
        'headline-md': ['22px', { lineHeight: '28px', letterSpacing: '-0.15px', fontWeight: '600' }],
        'title-lg': ['18px', { lineHeight: '24px', letterSpacing: '0px', fontWeight: '600' }],
        'title-md': ['16px', { lineHeight: '22px', letterSpacing: '0px', fontWeight: '600' }],
        'body-lg': ['15px', { lineHeight: '22px', letterSpacing: '0px', fontWeight: '400' }],
        'body-md': ['14px', { lineHeight: '20px', letterSpacing: '0px', fontWeight: '400' }],
        'body-sm': ['13px', { lineHeight: '18px', letterSpacing: '0px', fontWeight: '400' }],
        'label-lg': ['14px', { lineHeight: '20px', letterSpacing: '0.1px', fontWeight: '600' }],
        'label-md': ['12px', { lineHeight: '16px', letterSpacing: '0.2px', fontWeight: '600' }],
        'label-sm': ['11px', { lineHeight: '14px', letterSpacing: '0.2px', fontWeight: '500' }],
        'mono-sm': ['12px', { lineHeight: '16px', letterSpacing: '0px', fontWeight: '500' }],
      },
      transitionDuration: {
        'state-change': '120ms',
        'surface-enter': '220ms',
        'surface-exit': '150ms',
      },
      transitionDelay: {
        'state-change': '0ms',
        'surface-enter': '0ms',
        'surface-exit': '0ms',
      },
      transitionTimingFunction: {
        'state-change': 'ease-out',
        'surface-enter': 'cubic-bezier(0.2, 0, 0, 1)',
        'surface-exit': 'cubic-bezier(0.3, 0, 1, 1)',
      },
    },
  },
};
if (typeof module !== 'undefined') module.exports = globalThis.tailwind.config;
</script>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&amp;family=Red+Hat+Display:wght@600;700&amp;family=Red+Hat+Mono:wght@500&amp;display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet">
  <style>.material-symbols-outlined, .material-symbols-rounded, .material-symbols-sharp, .material-icons { display: inline-block; width: 1em; height: 1em; line-height: 1 !important; box-sizing: content-box; overflow: hidden; white-space: nowrap; direction: ltr; vertical-align: middle; }</style>
</head>
<body class="bg-light-surface text-light-on-surface font-body antialiased">
  <main class="min-h-[1024px] flex items-center justify-center p-gutter-md lg:p-gutter-xl" data-stitch-vh="min-h-[1024px]===min-h-screen">
    <div class="w-full max-w-4xl bg-light-surface-container-lowest border border-light-outline-variant/60 rounded-xl shadow-sm overflow-hidden grid grid-cols-1 lg:grid-cols-2">
      <!-- Left: Visual / Brand Panel -->
      <section class="bg-light-surface-container-low p-gutter-lg lg:p-gutter-xl flex flex-col justify-between gap-gutter-lg border-b lg:border-b-0 lg:border-r border-light-outline-variant/60">
        <div class="flex items-center gap-gutter-sm">
          <div class="w-10 h-10 rounded-lg bg-light-primary text-light-on-primary inline-flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[22px]" aria-hidden="true">local_library</span>
          </div>
          <div>
            <span data-design-text-token="title-lg" class="font-headline text-title-lg text-light-on-surface block leading-none">AGX Library</span>
            <span data-design-text-token="label-sm" class="font-label text-label-sm text-light-on-surface-variant">Sistema de Biblioteca Acadêmica</span>
          </div>
        </div>

        <div class="rounded-lg overflow-hidden bg-light-surface-container-lowest border border-light-outline-variant/40">
          <img src="data:image/png;base64," alt="Ilustração minimalista de livros acadêmicos empilhados" class="w-full h-56 lg:h-64 object-cover">
        </div>

        <div class="flex flex-col gap-1">
          <p data-design-text-token="title-md" class="font-title text-title-md text-light-on-surface text-balance">Acervo acadêmico organizado em um só lugar.</p>
          <p data-design-text-token="body-sm" class="font-body text-body-sm text-light-on-surface-variant text-pretty">Consulte exemplares disponíveis, acompanhe seus empréstimos e gerencie devoluções com simplicidade.</p>
        </div>
      </section>

      <!-- Right: Login Form -->
      <section class="p-gutter-lg lg:p-gutter-xl flex flex-col justify-center">
        <div class="w-full max-w-sm mx-auto flex flex-col gap-gutter-lg">
          <header class="flex flex-col gap-1">
            <h1 data-design-text-token="headline-lg" class="font-headline text-headline-lg text-light-on-surface">Acessar conta</h1>
            <p data-design-text-token="body-md" class="font-body text-body-md text-light-on-surface-variant">Entre com seu e-mail institucional e senha.</p>
          </header>

          <form action="../dashboard-catalogo/DashboardCatalogo.html" method="get" class="flex flex-col gap-gutter-md">
            <!-- COMPONENT: input-field-icon -->
            <label data-component-id="input-field-icon" data-component-type="input-field" data-component-variant="with-icon" class="flex flex-col gap-1.5">
              <span data-design-text-token="label-md" class="font-label text-label-md text-light-on-surface">E-mail</span>
              <div class="relative flex items-center">
                <span class="material-symbols-outlined text-[18px] text-light-outline absolute left-3 pointer-events-none" aria-hidden="true">mail</span>
                <input type="email" required value="marina.almeida@agx.edu.br" placeholder="seu.nome@agx.edu.br" inputmode="email" class="w-full rounded-md border border-light-outline-variant bg-light-surface-container-lowest pl-10 pr-3 py-2.5 font-body text-body-md text-light-on-surface placeholder:text-light-outline focus:border-light-primary focus:ring-1 focus:ring-light-primary">
              </div>
            </label>

            <!-- COMPONENT: input-field-password -->
            <label data-component-id="input-field-password" data-component-type="input-field" data-component-variant="password" class="flex flex-col gap-1.5">
              <span data-design-text-token="label-md" class="font-label text-label-md text-light-on-surface">Senha</span>
              <div class="relative flex items-center">
                <span class="material-symbols-outlined text-[18px] text-light-outline absolute left-3 pointer-events-none" aria-hidden="true">lock</span>
                <input id="login-password" type="password" required value="••••••••" placeholder="Digite sua senha" autocomplete="current-password" class="w-full rounded-md border border-light-outline-variant bg-light-surface-container-lowest pl-10 pr-10 py-2.5 font-body text-body-md text-light-on-surface placeholder:text-light-outline focus:border-light-primary focus:ring-1 focus:ring-light-primary">
                <button type="button" id="toggle-password" aria-label="Mostrar senha" class="absolute right-2.5 text-light-outline hover:text-light-on-surface p-1 rounded-sm cursor-pointer">
                  <span id="toggle-password-icon" class="material-symbols-outlined text-[18px]" aria-hidden="true">visibility</span>
                </button>
              </div>
            </label>

            <!-- COMPONENT: button-primary -->
            <button data-component-id="button-primary" data-component-type="button" data-component-variant="primary" type="submit" class="w-full mt-gutter-xs inline-flex items-center justify-center gap-gutter-sm px-gutter-md py-2.5 rounded-md bg-light-primary text-light-on-primary font-body hover:bg-light-primary-container focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light-primary focus-visible:ring-offset-2 transition-colors duration-state-change ease-state-change cursor-pointer">
              <span data-design-text-token="label-lg" class="text-label-lg">Entrar</span>
            </button>
          </form>

          <footer class="pt-gutter-md border-t border-light-outline-variant/60 text-center">
            <p data-design-text-token="body-sm" class="font-body text-body-sm text-light-on-surface-variant">
              Ainda não possui acesso?
              <a href="../cadastro/Cadastro.html" class="font-label text-label-md text-light-primary hover:underline ml-1">Criar uma conta</a>
            </p>
          </footer>
        </div>
      </section>
    </div>
  </main>

  <script>
    const pwdInput = document.getElementById('login-password');
    const toggleBtn = document.getElementById('toggle-password');
    const toggleIcon = document.getElementById('toggle-password-icon');
    if (toggleBtn && pwdInput && toggleIcon) {
      toggleBtn.addEventListener('click', () => {
        const isPwd = pwdInput.type === 'password';
        pwdInput.type = isPwd ? 'text' : 'password';
        toggleIcon.textContent = isPwd ? 'visibility_off' : 'visibility';
      });
    }
  </script>


</body></html>